{
  "name": "cy",
  "publisher": "symbiotyc",
  "version": "1.8.66",
  "displayName": "CY",
  "description": "CY: coding agent powered by SYMBIOTYC provider.",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "vscode": "^1.96.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Symbiotyc/CYIDE"
  },
  "homepage": "https://symbiotyc.dev",
  "bugs": {
    "url": "https://github.com/Symbiotyc/CYIDE/issues"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "cy",
    "symbiotyc",
    "cyborg",
    "agent",
    "i1a",
    "vibe"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./out/extension.js",
  "enabledApiProposals": [
    "chatSessionsProvider",
    "languageModelProxy"
  ],
  "icon": "resources/cy-logo.png",
  "galleryBanner": {
    "color": "#1a0303",
    "theme": "dark"
  },
  "contributes": {
    "commands": [
      {
        "command": "cy.openSidebar",
        "title": "\u041e\u0442\u043a\u0440\u044b\u0442\u044c CY",
        "category": "CY",
        "icon": {
          "light": "resources/cy-mark-dark.svg",
          "dark": "resources/cy-mark-light.svg"
        }
      },
      {
        "command": "cy.newCyPanel",
        "title": "\u0417\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u0430\u0433\u0435\u043d\u0442\u0430",
        "category": "CY",
        "icon": "$(plus)"
      },
      {
        "command": "cy.newChat",
        "title": "\u041f\u0435\u0440\u0435\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u0442\u044c \u0447\u0430\u0442",
        "category": "CY"
      },
      {
        "command": "cy.openCommandMenu",
        "title": "\u041f\u0430\u043b\u0438\u0442\u0440\u0430 CY",
        "category": "CY"
      },
      {
        "command": "cy.addToThread",
        "title": "\u041e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u0432\u044b\u0434\u0435\u043b\u0435\u043d\u043d\u043e\u0435 \u0432 CY",
        "category": "CY"
      },
      {
        "command": "cy.addFileToThread",
        "title": "\u041e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u0444\u0430\u0439\u043b \u0432 CY",
        "category": "CY"
      },
      {
        "command": "cy.implementTodo",
        "title": "\u0412\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u044c \u0447\u0435\u0440\u0435\u0437 CY",
        "category": "CY",
        "enablement": "false"
      },
      {
        "command": "cy.showLspMcpCliArgs",
        "title": "\u0421\u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b \u044f\u0434\u0440\u0430",
        "category": "CY"
      },
      {
        "command": "cy.dumpNuxState",
        "title": "\u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430: \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0437\u0430\u043f\u0443\u0441\u043a\u0430",
        "category": "CY",
        "enablement": "cy.sidebarView.visible"
      },
      {
        "command": "cy.resetNuxState",
        "title": "\u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430: \u0441\u0431\u0440\u043e\u0441\u0438\u0442\u044c \u0437\u0430\u043f\u0443\u0441\u043a",
        "category": "CY",
        "enablement": "cy.sidebarView.visible"
      }
    ],
    "keybindings": [
      {
        "command": "cy.openSidebar",
        "key": "ctrl+alt+y",
        "mac": "cmd+alt+y"
      },
      {
        "command": "cy.newCyPanel",
        "key": "ctrl+alt+shift+y",
        "mac": "cmd+alt+shift+y"
      },
      {
        "command": "cy.openCommandMenu",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      },
      {
        "command": "cy.addToThread",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorTextFocus"
      },
      {
        "command": "cy.newChat",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "cy.supportsNewChatKeyShortcut"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "CY",
      "properties": {
        "cy.provider": {
          "order": 1,
          "markdownDescription": "\u0410\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u043a\u043e\u043d\u0442\u0443\u0440. CY \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u0447\u0435\u0440\u0435\u0437 **SYMBIOTYC / CY i1a** \u2014 \u043a\u043e\u043d\u0442\u0443\u0440 \u0437\u0430\u043a\u0440\u0435\u043f\u043b\u0451\u043d \u0438 \u043d\u0435 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f.",
          "type": "string",
          "enum": [
            "SYMBIOTYC / CY i1a"
          ],
          "enumDescriptions": [
            "Cyborg-\u043a\u043e\u043d\u0442\u0443\u0440 SYMBIOTYC. \u0417\u0430\u043a\u0440\u0435\u043f\u043b\u0451\u043d."
          ],
          "default": "SYMBIOTYC / CY i1a",
          "scope": "application"
        },
        "cy.openOnStartup": {
          "order": 2,
          "description": "\u0420\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u0442\u044c \u043f\u0430\u043d\u0435\u043b\u044c CY \u0441\u0440\u0430\u0437\u0443 \u043f\u0440\u0438 \u0441\u0442\u0430\u0440\u0442\u0435 \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440\u0430.",
          "type": "boolean",
          "default": true
        },
        "cy.composerEnterBehavior": {
          "order": 3,
          "description": "\u041a\u0430\u043a Enter \u0432\u0435\u0434\u0451\u0442 \u0441\u0435\u0431\u044f \u0432 \u043f\u043e\u043b\u0435 \u0432\u0432\u043e\u0434\u0430.",
          "type": "string",
          "enum": [
            "enter",
            "cmdIfMultiline",
            "cmdAlways"
          ],
          "enumDescriptions": [
            "Enter \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442",
            "Enter \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442, \u043f\u043e\u043a\u0430 \u0442\u0435\u043a\u0441\u0442 \u0432 \u043e\u0434\u043d\u0443 \u0441\u0442\u0440\u043e\u043a\u0443",
            "\u041e\u0442\u043f\u0440\u0430\u0432\u043a\u0430 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e Cmd/Ctrl+Enter"
          ],
          "default": "enter"
        },
        "cy.followUpQueueMode": {
          "order": 4,
          "description": "\u0427\u0442\u043e \u0434\u0435\u043b\u0430\u0442\u044c \u0441 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435\u043c, \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u043c \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0440\u0430\u0431\u043e\u0442\u044b \u0430\u0433\u0435\u043d\u0442\u0430.",
          "type": "string",
          "enum": [
            "queue",
            "steer",
            "interrupt"
          ],
          "enumDescriptions": [
            "\u041f\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0432 \u043e\u0447\u0435\u0440\u0435\u0434\u044c",
            "\u0421\u043a\u043e\u0440\u0440\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0442\u0435\u043a\u0443\u0449\u0438\u0439 \u0445\u043e\u0434",
            "\u041f\u0440\u0435\u0440\u0432\u0430\u0442\u044c \u0438 \u043d\u0430\u0447\u0430\u0442\u044c \u0437\u0430\u043d\u043e\u0432\u043e"
          ],
          "default": "queue"
        },
        "cy.reviewDelivery": {
          "order": 5,
          "description": "\u0413\u0434\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0440\u0430\u0437\u0431\u043e\u0440 \u043a\u043e\u0434\u0430.",
          "type": "string",
          "enum": [
            "inline",
            "detached"
          ],
          "enumDescriptions": [
            "\u0412 \u0442\u0435\u043a\u0443\u0449\u0435\u043c \u0447\u0430\u0442\u0435",
            "\u0412 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e\u043c \u0447\u0430\u0442\u0435"
          ],
          "default": "inline"
        },
        "cy.commentCodeLensEnabled": {
          "order": 6,
          "description": "\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0443 CY \u043d\u0430\u0434 TODO-\u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u044f\u043c\u0438.",
          "type": "boolean",
          "default": true
        },
        "cy.localeOverride": {
          "order": 7,
          "description": "\u042f\u0437\u044b\u043a \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430. \u041f\u0443\u0441\u0442\u043e \u2014 \u043a\u0430\u043a \u0432 \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440\u0435.",
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "scope": "application"
        },
        "cy.runCyInWindowsSubsystemForLinux": {
          "order": 8,
          "description": "Windows: \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0442\u044c \u044f\u0434\u0440\u043e CY \u0432\u043d\u0443\u0442\u0440\u0438 WSL. \u0422\u0440\u0435\u0431\u0443\u0435\u0442 \u043f\u0435\u0440\u0435\u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0438 \u043e\u043a\u043d\u0430.",
          "type": "boolean",
          "default": false
        },
        "cy.cliExecutable": {
          "order": 99,
          "markdownDescription": "\u041f\u0443\u0442\u044c \u043a \u044f\u0434\u0440\u0443 CY. \u0421\u043b\u0443\u0436\u0435\u0431\u043d\u044b\u0439 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440 \u2014 \u043c\u0435\u043d\u044f\u0442\u044c \u043d\u0435 \u043d\u0443\u0436\u043d\u043e.",
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "scope": "application",
          "restricted": true
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cyViewContainer",
          "title": "CY",
          "icon": "resources/cy-mark-dark.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "cySecondaryViewContainer",
          "title": "CY",
          "icon": "resources/cy-mark-dark.svg",
          "when": "false"
        }
      ]
    },
    "views": {
      "cyViewContainer": [
        {
          "id": "cy.sidebarView",
          "type": "webview",
          "name": "CY"
        }
      ],
      "cySecondaryViewContainer": [
        {
          "id": "cy.sidebarSecondaryView",
          "type": "webview",
          "name": "CY",
          "when": "false"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "cy.conversationEditor",
        "displayName": "\u0427\u0430\u0442 CY",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "symbiotyc-cy:/**/*"
          }
        ]
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "cy.openSidebar",
          "group": "navigation",
          "when": "resourceScheme == file"
        }
      ],
      "editor/context": [
        {
          "submenu": "cy.editorSubmenu",
          "group": "1_cy",
          "when": "resourceScheme == file"
        }
      ],
      "cy.editorSubmenu": [
        {
          "command": "cy.addToThread",
          "group": "1_send@1"
        },
        {
          "command": "cy.addFileToThread",
          "group": "1_send@2"
        },
        {
          "command": "cy.openCommandMenu",
          "group": "2_act@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "cy.addFileToThread",
          "group": "2_chat",
          "order": 2,
          "when": "resourceScheme == file"
        }
      ],
      "explorer/context": [
        {
          "command": "cy.addFileToThread",
          "group": "7_cy",
          "when": "resourceScheme == file"
        }
      ],
      "view/title": [
        {
          "command": "cy.newCyPanel",
          "when": "view == cy.sidebarView",
          "group": "navigation@1"
        },
        {
          "command": "cy.newChat",
          "when": "view == cy.sidebarView",
          "group": "1_manage@1"
        },
        {
          "command": "cy.openCommandMenu",
          "when": "view == cy.sidebarView",
          "group": "1_manage@2"
        }
      ],
      "webview/context": [
        {
          "command": "cy.newChat",
          "when": "(webviewId == 'cy.sidebarView' || webviewId == 'cy.sidebarSecondaryView') && cy.supportsNewChatMenu"
        }
      ],
      "commandPalette": [
        {
          "command": "cy.showLspMcpCliArgs",
          "when": "cy.lspMcpEnabled"
        },
        {
          "command": "cy.implementTodo",
          "when": "false"
        }
      ],
      "chatSessions/newSession": [
        {
          "command": "cy.newCyPanel",
          "when": "chatSessionType == symbiotyc-cy"
        }
      ]
    },
    "submenus": [
      {
        "id": "cy.editorSubmenu",
        "label": "CY"
      }
    ],
    "chatSessions": [
      {
        "type": "symbiotyc-cy",
        "name": "CY",
        "displayName": "CY",
        "description": "Cyborg-\u0430\u0433\u0435\u043d\u0442 SYMBIOTYC \u0432\u043d\u0443\u0442\u0440\u0438 \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440\u0430"
      }
    ],
    "grammars": [
      {
        "language": "cy-rules",
        "scopeName": "source.cy-rules",
        "path": "./syntaxes/starlark.tmLanguage.json"
      }
    ],
    "languages": [
      {
        "id": "cy-rules",
        "aliases": [
          "\u041f\u0440\u0430\u0432\u0438\u043b\u0430 CY"
        ],
        "extensions": [
          ".rules"
        ],
        "configuration": "./syntaxes/starlark.configuration.json"
      }
    ]
  }
}